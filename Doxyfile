# Run from the repository root: doxygen Doxyfile (or cmake --build build --target docs).

PROJECT_NAME           = "Botan Hybrid TLS Test Server"
PROJECT_BRIEF          = "HTTP/2 and WSS over Botan TLS 1.3 with post-quantum key exchange"
OUTPUT_DIRECTORY       = build/docs
CREATE_SUBDIRS         = NO

INPUT                  = src docs/modules.dox README.md
FILE_PATTERNS          = *.hpp *.dox
RECURSIVE              = YES
STRIP_FROM_PATH        = src
STRIP_FROM_INC_PATH    = src
USE_MDFILE_AS_MAINPAGE = README.md

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
JAVADOC_AUTOBRIEF      = YES
INHERIT_DOCS           = YES
SORT_MEMBER_DOCS       = NO
GROUP_NESTED_COMPOUNDS = YES

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO

HAVE_DOT               = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
DOT_IMAGE_FORMAT       = svg

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
